ANTHROPIC_API_KEY=your-key-here
DATABASE_URL=postgresql://localhost/job_search_agent
TEST_DATABASE_URL=postgresql://localhost/job_search_agent_test

# Langfuse-Tracing (optional). Fehlen public/secret key, ist Tracing
# einfach aus — kein Fehler, der Agent läuft normal weiter.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
